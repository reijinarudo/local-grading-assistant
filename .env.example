# Copy this file to .env and fill in your own values. .env is listed in .gitignore.
# The scripts in server/ read these values. Nothing here is a secret by default,
# since every service binds to your own machine or LAN.

# ---- Layer 1: model server (llama.cpp llama-server) ----
# Path to the llama-server binary. "llama-server" works if it is on your PATH (Homebrew installs it there).
LLAMA_SERVER=llama-server
# Path to a GGUF model file you downloaded, for example from Hugging Face.
MODEL_PATH=/path/to/your-model.gguf
# Name the model is published under in the API and in Open WebUI's model menu.
MODEL_ALIAS=local-model
# 127.0.0.1 keeps the model reachable only from this machine. Open WebUI talks to it locally.
MODEL_HOST=127.0.0.1
MODEL_PORT=8090
# Context window in tokens. Larger values use more memory for the KV cache.
MODEL_CTX=32768
# Optional chat-template switches, passed to --chat-template-kwargs. Leave empty if your
# model's template has no such option. Keep the single quotes. Example for Qwen3-family models:
# CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
CHAT_TEMPLATE_KWARGS=

# ---- Layer 2: Open WebUI ----
# Python virtual environment that holds Open WebUI (see README, Installation).
WEBUI_VENV=$HOME/open-webui/.venv
# Where Open WebUI keeps its database, uploads, and settings.
WEBUI_DATA_DIR=$HOME/open-webui/data
# 0.0.0.0 makes the web interface reachable from other machines on your LAN.
WEBUI_HOST=0.0.0.0
WEBUI_PORT=3000
# Open WebUI sends this key to the model server. llama-server does not check it unless you
# start it with --api-key. Any placeholder works for a local-only setup.
OPENAI_API_KEY=replace-with-any-local-placeholder
# Set to 1 after the first start, once Open WebUI has downloaded its embedding model,
# so it stops contacting Hugging Face on every start.
HF_HUB_OFFLINE=0

# ---- Layer 3: grading tools ----
# Folder on the server that holds make_packet.py, course_config.json, the blank workbook,
# and the course data file. The Open WebUI filter reads it.
GRADER_DIR=$HOME/grader
# Where generated evidence packets and chart images are saved.
GRADER_PACKETS_DIR=$HOME/grader/packets
# Course config used by make_packet.py when --config is not given.
GRADER_CONFIG=$HOME/grader/course_config.json
